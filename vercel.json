{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/adminhtml"
    },
    {
      "source": "/socialjs",
      "destination": "/socialjs"
    },
    {
      "source": "/((?!api|admin|socialjs)*)" ,
      "destination": "/indexhtml"
    }
  ]
}
