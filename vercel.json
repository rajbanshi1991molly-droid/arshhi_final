{
  "version": 2,
  "builds": [
    {
      "src": "api/*js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/public/adminhtml"
    },
    {
      "source": "/socialjs",
      "destination": "/public/socialjs"
    },
    {
      "source": "/(*)",
      "destination": "/public/indexhtml"
    }
  ]
}
